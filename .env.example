# Copiar a .env y completar (no subir .env al repositorio).
#
# Token: API Tokens → Create Token → plantilla "Read analytics" o personalizado con:
#   - Zone → Zone → Read
#   - Zone → Analytics → Read
#
# Documentación: https://developers.cloudflare.com/fundamentals/api/get-started/create-token/

CF_API_TOKEN=

# Opcional: acotar el listado de zonas a una cuenta concreta (UUID de cuenta).
# CF_ACCOUNT_ID=

# Días de historia por zona (máx. 31).
# ZONE_DAYS=14

# Intervalo entre actualizaciones en ms (por defecto 24 h).
# UPDATE_INTERVAL_MS=86400000

# El agregador escribe en ./traffic/stats.json (montado en nginx como /traffic/stats.json).
